{
  "name": "referentiels-sante",
  "version": "0.3.2",
  "description": "Référentiels publics de la santé en France (FINESS+, NOS, CCAM, CIM-10, médicaments, NABM, LPP, UCD, tarifs GHS) convertis en CSV et JSON propres, sans dépendance",
  "keywords": [
    "finess",
    "finess+",
    "nos",
    "ans",
    "atih",
    "ghs",
    "ccam",
    "cim-10",
    "bdpm",
    "nabm",
    "lpp",
    "ucd",
    "dbf",
    "sante",
    "hopital",
    "open-data",
    "referentiel",
    "nomenclature"
  ],
  "homepage": "https://github.com/Irreductix/referentiels-sante#readme",
  "bugs": "https://github.com/Irreductix/referentiels-sante/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Irreductix/referentiels-sante.git"
  },
  "license": "MIT",
  "author": "Quentin Cazier",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./finess": "./src/finess/index.js",
    "./nos": "./src/nos/index.js",
    "./ghs": "./src/ghs/index.js",
    "./ccam": "./src/ccam/index.js",
    "./cim10": "./src/cim10/index.js",
    "./bdpm": "./src/bdpm/index.js",
    "./cnam": "./src/cnam/index.js",
    "./commun/json-flux": "./src/commun/json-flux.js",
    "./commun/dbf": "./src/commun/dbf.js",
    "./commun/xml": "./src/commun/xml.js"
  },
  "bin": {
    "referentiels-sante": "src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "finess": "node ./src/cli.js finess",
    "nos": "node ./src/cli.js nos",
    "ghs": "node ./src/cli.js ghs"
  },
  "engines": {
    "node": ">=22"
  }
}
